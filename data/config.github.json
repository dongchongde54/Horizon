{
  "version": "1.0",
  "ai": {
    "provider": "openai",
    "model": "YOUR_MODEL_ID",
    "api_key_env": "OPENAI_API_KEY",
    "base_url": "${HORIZON_AI_BASE_URL}",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 1,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1
  },
  "email": {
    "enabled": true,
    "smtp_server": "smtp.gmail.com",
    "smtp_port": 465,
    "smtp_username": null,
    "imap_enabled": false,
    "imap_server": "",
    "imap_port": 993,
    "email_address": "${EMAIL_ADDRESS}",
    "password_env": "EMAIL_PASSWORD",
    "sender_name": "每周全球与 SRE 情报",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE"
  },
  "sources": {
    "github": [
      {
        "type": "repo_releases",
        "owner": "kubernetes",
        "repo": "kubernetes",
        "enabled": true,
        "category": "sre-release"
      },
      {
        "type": "repo_releases",
        "owner": "prometheus",
        "repo": "prometheus",
        "enabled": true,
        "category": "sre-release"
      },
      {
        "type": "repo_releases",
        "owner": "grafana",
        "repo": "grafana",
        "enabled": true,
        "category": "sre-release"
      },
      {
        "type": "repo_releases",
        "owner": "open-telemetry",
        "repo": "opentelemetry-collector",
        "enabled": true,
        "category": "sre-release"
      },
      {
        "type": "repo_releases",
        "owner": "cilium",
        "repo": "cilium",
        "enabled": true,
        "category": "sre-release"
      },
      {
        "type": "repo_releases",
        "owner": "argoproj",
        "repo": "argo-cd",
        "enabled": true,
        "category": "sre-release"
      },
      {
        "type": "repo_releases",
        "owner": "helm",
        "repo": "helm",
        "enabled": true,
        "category": "sre-release"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 100,
      "category": "ai-open-source"
    },
    "rss": [
      {
        "name": "BBC World",
        "url": "https://feeds.bbci.co.uk/news/world/rss.xml",
        "enabled": true,
        "category": "world-news"
      },
      {
        "name": "NASA JPL News",
        "url": "https://www.jpl.nasa.gov/feeds/news/",
        "enabled": true,
        "category": "science-society"
      },
      {
        "name": "Nature",
        "url": "https://www.nature.com/nature.rss",
        "enabled": true,
        "category": "science-society"
      },
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-open-source"
      },
      {
        "name": "GitHub Engineering",
        "url": "https://github.blog/engineering/feed/",
        "enabled": true,
        "category": "ai-open-source"
      },
      {
        "name": "Kubernetes Blog",
        "url": "https://kubernetes.io/feed.xml",
        "enabled": true,
        "category": "sre"
      },
      {
        "name": "CNCF Blog",
        "url": "https://www.cncf.io/feed/",
        "enabled": true,
        "category": "sre"
      },
      {
        "name": "OpenTelemetry Blog",
        "url": "https://opentelemetry.io/blog/index.xml",
        "enabled": true,
        "category": "observability"
      },
      {
        "name": "Cloudflare Blog",
        "url": "https://blog.cloudflare.com/rss/",
        "enabled": true,
        "category": "infra"
      }
    ],
    "reddit": {
      "enabled": true,
      "fetch_comments": 5,
      "subreddits": [
        {
          "subreddit": "sre",
          "enabled": true,
          "sort": "top",
          "time_filter": "week",
          "fetch_limit": 15,
          "min_score": 5,
          "category": "sre"
        },
        {
          "subreddit": "devops",
          "enabled": true,
          "sort": "top",
          "time_filter": "week",
          "fetch_limit": 15,
          "min_score": 10,
          "category": "sre"
        },
        {
          "subreddit": "kubernetes",
          "enabled": true,
          "sort": "top",
          "time_filter": "week",
          "fetch_limit": 15,
          "min_score": 10,
          "category": "sre"
        }
      ],
      "users": []
    },
    "twitter": {
      "enabled": false,
      "users": [],
      "fetch_limit": 10,
      "category": "ai-open-source",
      "fetch_reply_text": false,
      "max_replies_per_tweet": 3,
      "max_tweets_to_expand": 10,
      "reply_min_likes": 5
    },
    "openbb": {
      "enabled": true,
      "fetch_filings": false,
      "filings_provider": "sec",
      "watchlists": [
        {
          "name": "global-tech-and-markets",
          "enabled": true,
          "provider": "yfinance",
          "fetch_limit": 25,
          "category": "equities",
          "symbols": [
            "AAPL",
            "MSFT",
            "NVDA",
            "GOOGL",
            "AMZN",
            "META",
            "TSLA",
            "ORCL",
            "IBM",
            "CRM",
            "NET",
            "DDOG"
          ]
        }
      ]
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_28_days",
      "languages": [
        "All",
        "Go",
        "Python",
        "TypeScript",
        "Rust"
      ],
      "keywords": [],
      "min_stars": 20,
      "max_items": 25,
      "category": "oss-trending"
    },
    "gdelt": {
      "enabled": true,
      "query": "geopolitics OR elections OR conflict OR global economy OR trade OR energy OR climate OR public health",
      "mode": "ArtList",
      "max_records": 40,
      "timespan": "7d",
      "language": null,
      "country": null,
      "category": "world-news"
    },
    "google_news": {
      "enabled": true,
      "query": "science OR health OR medicine OR space OR energy OR climate OR environment",
      "language": "en",
      "country": "US",
      "ceid": null,
      "max_results": 35,
      "category": "science-society"
    }
  },
  "filtering": {
    "ai_score_threshold": 6.0,
    "time_window_hours": 168,
    "max_items": 20,
    "category_groups": {
      "global": {
        "name": "全球热点",
        "limit": 5,
        "categories": [
          "world-news"
        ]
      },
      "finance": {
        "name": "财经市场",
        "limit": 3,
        "categories": [
          "finance",
          "equities"
        ]
      },
      "science": {
        "name": "科学与社会",
        "limit": 3,
        "categories": [
          "science-society"
        ]
      },
      "ai": {
        "name": "AI 与开源",
        "limit": 5,
        "categories": [
          "ai-open-source",
          "oss-trending"
        ]
      },
      "sre": {
        "name": "SRE 专题",
        "limit": 4,
        "categories": [
          "sre",
          "sre-release",
          "observability",
          "infra"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": null
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "text": "#{message_title}\n\n#{summary}"
    },
    "headers": ""
  }
}
